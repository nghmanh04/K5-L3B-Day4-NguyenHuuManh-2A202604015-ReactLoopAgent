# DeepSeek API direct
PROVIDER=deepseek
API_MODEL=deepseek-flash
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# Alternatively, OpenCode Go can serve DeepSeek V4.1 Flash:
# PROVIDER=openrouter
# API_ENDPOINT=https://opencode.ai/inference/go/openai/v1
# API_MODEL=deepseek-v4.1-flash
# API_KEY=YOUR_OPENCODE_API_KEY
